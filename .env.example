DB_DSN=postgresql://fleet:fleet@localhost:55432/fleet
FLEET_API_BASE=http://localhost:8099
FLEET_API_TOKEN=local-dev-token
# When EVENTGRID_ENDPOINT is unset the publisher runs in emulated mode and POSTs
# Event Grid schema envelopes directly to HANDLER_URL instead of a real topic.
EVENTGRID_ENDPOINT=
EVENTGRID_KEY=
HANDLER_URL=http://localhost:7099/api/eventgrid
PAGE_SIZE=1000
LOOKBACK_HOURS=720
# Pluggable alert sink (leave blank to only write Markdown + GH annotation).
ALERT_WEBHOOK=
